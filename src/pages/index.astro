---
import { Picture } from 'astro:assets';
import Arrow from '../components/Arrow.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ContactForm from '../components/ContactForm.astro';
import CosmicBackground from '../components/CosmicBackground.astro';
import OrbitalScene from '../components/OrbitalScene.astro';
import ship from '../assets/nave-orbital.webp';
import { profile, skillGroups, experience, education } from '../data/site';
import { projects } from '../data/projects';

const base = import.meta.env.BASE_URL;
const featured = projects.filter((project) => project.featured);
const timeline = [
  { title: 'Experiencia', kind: 'work', entries: experience },
  { title: 'Educación', kind: 'education', entries: education },
];
---
<BaseLayout title="Aldo Allende | Desarrollador frontend" description="Portafolio de Aldo Allende, desarrollador frontend. Explora sus aplicaciones web, proyectos con React, PHP y JavaScript y un minijuego orbital.">
  <div class="hero-backdrop">
    <CosmicBackground />
    <section class="hero container" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow hero-eyebrow"><span></span> PORTAFOLIO DIGITAL <b>/</b> CDMX, MX</p>
        <h1 id="hero-title">Aldo<br /><em>Allende<span>.</span></em></h1>
        <p class="hero-role">Desarrollador frontend</p>
        <p class="hero-description">Construyo aplicaciones web y exploro lo que pasa cuando se cruzan el código, el diseño y la animación.</p>
        <div class="hero-buttons">
          <a class="button button-primary" href="#proyectos">Ver proyectos <Arrow direction="down-right" /></a>
          <a class="hero-contact" href="#contacto">Hablemos <Arrow /></a>
        </div>
      </div>
      <OrbitalScene />
    </section>
    <div class="container hero-rail">
      <a href="#proyectos" class="scroll-link"><Arrow direction="down" /> Explorar portafolio</a>
      <div class="hero-social" aria-label="Mis perfiles">
        <a href={profile.github} target="_blank" rel="noopener noreferrer">GitHub <Arrow /></a>
        <a href={profile.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn <Arrow /></a>
      </div>
    </div>
  </div>

  <section class="section" id="proyectos" aria-labelledby="projects-heading">
    <div class="container">
      <div class="section-intro">
        <div><span class="section-number">01 <b>/</b> PROYECTOS</span><h2 id="projects-heading">Trabajo seleccionado<span class="accent">.</span></h2></div>
        <a class="text-link section-link" href={`${base}proyectos/`}>Ver los {projects.length} proyectos <Arrow /></a>
      </div>
      <div class="projects-grid featured-grid">
        {featured.map((project, index) => <ProjectCard project={project} index={index} featured lead={index === 0} />)}
      </div>
    </div>
  </section>

  <section class="section section-tinted" id="sobre-mi" aria-labelledby="about-heading">
    <div class="container about-layout">
      <figure class="about-illustration" data-about-illustration>
        <Picture
          src={ship}
          alt="Ilustración de una nave de exploración sobre una órbita violeta"
          formats={['avif']}
          fallbackFormat="webp"
          width={480}
          widths={[240, 320, 400, 480, 640, 800]}
          sizes="auto, (max-width: 640px) calc(100vw - 36px), min(430px, 40vw)"
          quality={55}
          loading="lazy"
          decoding="async"
        />
      </figure>
      <div class="about-text">
        <span class="section-number">02 <b>/</b> SOBRE MÍ</span>
        <h2 id="about-heading">De la ingeniería a la web<span class="accent">.</span></h2>
        {profile.about.map((paragraph) => <p>{paragraph}</p>)}
        <a class="text-link" href={profile.github} target="_blank" rel="noopener noreferrer">Conoce mi trabajo en GitHub <Arrow /></a>
      </div>
    </div>
  </section>

  <section class="section skills-section" id="habilidades" aria-labelledby="skills-heading">
    <div class="container">
      <div class="section-intro"><div><span class="section-number">03 <b>/</b> HABILIDADES</span><h2 id="skills-heading">Tecnologías que utilizo<span class="accent">.</span></h2></div></div>
      <div class="skill-grid">
        {skillGroups.map((group, index) => (
          <article class="skill-panel">
            <span class="skill-counter" aria-hidden="true">[0{index + 1}]</span>
            <h3>{group.title}</h3>
            <ul class="skill-list">{group.skills.map((skill) => <li>{skill}</li>)}</ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-tinted" id="trayectoria" aria-labelledby="experience-heading">
    <div class="container">
      <div class="section-intro"><div><span class="section-number">04 <b>/</b> TRAYECTORIA</span><h2 id="experience-heading">Experiencia y formación<span class="accent">.</span></h2></div></div>
      <div class="timeline-grid">
        {timeline.map(({ title, kind, entries }) => (
          <div class={`timeline-column timeline-column--${kind}`}>
            <h3>{title}</h3>
            <ol class="timeline-list">
              {entries.map((entry) => (
                <li class:list={['timeline-item', { 'timeline-item--current': entry.current }]}>
                  <span class="timeline-point" aria-hidden="true"></span>
                  <div class="timeline-item-heading"><h4>{entry.title}</h4>{entry.current && <span class="timeline-status">Actual</span>}</div>
                  <p>{entry.detail}</p>
                </li>
              ))}
            </ol>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section interests-section" id="intereses" aria-labelledby="interests-heading">
    <div class="container interests-layout">
      <div><span class="section-number">05 <b>/</b> INTERESES</span><h2 id="interests-heading">Fuera del código<span class="accent">.</span></h2><p>La música, el dibujo y los videojuegos también forman parte de mi manera de crear.</p></div>
      <a class="interest-card" href="https://aldoallens-tic-tac-toe.netlify.app/" target="_blank" rel="noopener noreferrer"><span class="interest-icon" aria-hidden="true">#</span><span><small>MINIJUEGO</small>Tic Tac Toe</span><span class="interest-arrow"><Arrow /></span></a>
    </div>
  </section>

  <section class="section contact-section" id="contacto" aria-labelledby="contact-heading">
    <div class="container contact-layout">
      <div class="contact-copy"><span class="section-number">06 <b>/</b> CONTACTO</span><h2 id="contact-heading">¿Construimos<br />algo juntos<span class="accent">?</span></h2><p>Si quieres conversar sobre un proyecto o una oportunidad de trabajo, escríbeme.</p><a class="contact-email" href={`mailto:${profile.email}`}>{profile.email} <Arrow /></a></div>
      <ContactForm />
    </div>
  </section>
</BaseLayout>

<style is:global>
  @media screen {
    .hero-backdrop ~ :is(#sobre-mi, #habilidades, #trayectoria, #intereses, #contacto) {
      content-visibility: auto;
    }

    /* Reserve space before the browser measures each off-screen section. */
    #sobre-mi { contain-intrinsic-block-size: auto 28rem; }
    #habilidades { contain-intrinsic-block-size: auto 22rem; }
    #trayectoria { contain-intrinsic-block-size: auto 28rem; }
    #intereses { contain-intrinsic-block-size: auto 11rem; }
    #contacto { contain-intrinsic-block-size: auto 30rem; }

    @media (max-width: 640px) {
      #sobre-mi { contain-intrinsic-block-size: auto 50rem; }
      #habilidades { contain-intrinsic-block-size: auto 42rem; }
      #trayectoria { contain-intrinsic-block-size: auto 49rem; }
      #intereses { contain-intrinsic-block-size: auto 18rem; }
      #contacto { contain-intrinsic-block-size: auto 47rem; }
    }
  }
</style>
