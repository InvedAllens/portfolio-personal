---
const base = import.meta.env.BASE_URL;
---
<figure class="orbital-scene" data-orbital>
  <div class="orbital-view" data-orbital-view>
    <img class="orbital-still" src={`${base}images/orbita.svg`} width="620" height="520" alt="Planeta con anillos luminosos y pequeñas lunas" fetchpriority="high" />
    <canvas class="orbital-canvas" width="620" height="520" aria-hidden="true"></canvas>
    <span class="orbital-cross orbital-cross--left" aria-hidden="true">+</span>
    <span class="orbital-cross orbital-cross--right" aria-hidden="true">+</span>

    <section class="mission" aria-label="Minijuego Misión Órbita" data-mission hidden>
      <div class="mission-field" data-mission-field role="group" tabindex="-1" aria-label="Campo de vuelo" aria-describedby="mission-help"></div>
      <div class="mission-hud">
        <span><strong data-mission-level>1</strong> <span>de <span data-mission-total></span></span><small>NIVEL</small></span>
        <span><strong data-mission-score>0</strong> <span>de <span data-mission-goal></span></span><small>ASTEROIDES</small></span>
        <span><strong data-mission-shield>3</strong> <span>de 3</span><small>ESCUDOS</small></span>
      </div>
      <div class="mission-notice" data-mission-notice hidden aria-hidden="true">
        <strong data-mission-title></strong>
        <p data-mission-detail></p>
      </div>
    </section>
  </div>

  <div class="orbital-controls">
    <p id="orbital-help" data-orbital-help>Minijuego de naves</p>
    <p id="mission-help" hidden><span>Flechas o WASD para moverte y espacio para disparar.</span> <span>Mantén pulsado y arrastra para volar y disparar.</span></p>
    <div class="mission-actions">
      <button class="mission-button mission-button--primary" type="button" data-mission-start hidden>
        <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="m7 5 8 5-8 5z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" /></svg>
        <span>Jugar</span>
      </button>
      <button class="mission-button mission-button--primary" type="button" data-mission-pause hidden>Pausar</button>
      <button class="mission-button" type="button" data-mission-exit hidden>Salir</button>
    </div>
  </div>
  <p class="mission-status" data-mission-status role="status"></p>
</figure>
<script src="../scripts/motion.js"></script>
