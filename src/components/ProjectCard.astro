---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Arrow from './Arrow.astro';
import type { Project } from '../data/projects';
interface Props { project: Project; index?: number; lead?: boolean; featured?: boolean; }
const { project, index = 0, lead = false, featured = false } = Astro.props;
const images = import.meta.glob<ImageMetadata>('../assets/projects/*.webp', { eager: true, import: 'default' });
const image = images[`../assets/projects/${project.image}.webp`];
const narrowSize = '(max-width: 640px) min(320px, calc(70vw - 26px)), (max-width: 960px) calc(35vw - 30px)';
const sizes = lead
  ? '(max-width: 640px) min(392px, calc(72vw - 26px)), (max-width: 960px) calc(41.5vw - 27px), min(392px, calc(41.5vw - 41px))'
  : `${narrowSize}, ${featured ? 'min(320px, calc(35vw - 41px))' : 'min(267px, calc(23.33vw - 32px))'}`;
const number = String(index + 1).padStart(2, '0');
---
<article class:list={['project-card', { 'project-card--lead': lead }]} id={project.id}>
  <div class="project-media">
    <span class="project-index" aria-hidden="true">{number} <span>/</span></span>
    <Picture
      src={image}
      alt={`Captura de ${project.title}`}
      formats={['avif']}
      fallbackFormat="webp"
      width={lead ? 392 : 320}
      widths={lead ? [240, 320, 392, 480, 560, 784] : [160, 240, 320, 400, 480, 640]}
      sizes={`auto, ${sizes}`}
      style={`aspect-ratio: ${image.width} / ${image.height}`}
      quality={55}
      loading="lazy"
      decoding="async"
    />
  </div>
  <div class="project-details">
    {lead && <span class="project-feature-label"><span aria-hidden="true">✳</span> PROYECTO DESTACADO</span>}
    <h3>{project.title}</h3>
    <p>{project.summary}</p>
    <ul class="project-tags" aria-label="Tecnologías utilizadas">
      {project.technologies.map((tech) => <li class="tag">{tech}</li>)}
    </ul>
    <div class="project-actions">
      <a class="text-link" href={project.demo} target="_blank" rel="noopener noreferrer" aria-label={`Ver demo de ${project.title} (abre en otra pestaña)`}>Ver demo <Arrow /></a>
      <a class="text-link muted-link" href={project.repository} target="_blank" rel="noopener noreferrer" aria-label={`Ver código de ${project.title} (abre en otra pestaña)`}>Código fuente <Arrow /></a>
    </div>
  </div>
</article>
