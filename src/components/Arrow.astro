---
interface Props { direction?: 'up-right' | 'down-right' | 'down'; }
const { direction = 'up-right' } = Astro.props;
const paths = {
  'up-right': 'M4 12 12 4M5 4h7v7',
  'down-right': 'm4 4 8 8m0-7v7H5',
  down: 'M8 3v10m-4-4 4 4 4-4',
};
---
<svg class="ui-arrow" viewBox="0 0 16 16" width="16" height="16" fill="none" aria-hidden="true">
  <path d={paths[direction]} stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
</svg>
