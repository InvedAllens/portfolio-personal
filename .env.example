# Copia este archivo como .env y completa tus datos (el .env NO se sube a GitHub)

# --- Base de datos ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=salon
DB_PASS=cambia_esta_clave
DB_BD=appsalon

# --- URL publica de la app (se usa en los enlaces de los correos) ---
# Local: http://localhost:3000   |   Produccion: https://tu-dominio.com
APP_URL=http://localhost:3000

# --- Correo (SMTP). Si MAIL_HOST se deja vacio, los correos NO se envian y el
#     enlace de confirmacion/recuperacion se escribe en el log de errores de PHP
#     (util para desarrollar sin configurar un servidor de correo).
MAIL_HOST=
MAIL_PORT=2525
MAIL_USER=
MAIL_PASS=
MAIL_ENCRYPTION=tls
MAIL_FROM=cuentas@appsalon.com

# true muestra mensajes de error detallados (solo en desarrollo)
APP_DEBUG=false
